# Google Cloud Configuration for IdeaB2B Travel Platform

# Application
APP_NAME="IdeaB2B Travel Platform"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ideab2b-173142818446.asia-south2.run.app

# Database (Cloud SQL)
DB_CONNECTION=mysql
DB_HOST=10.0.0.3  # Cloud SQL private IP
DB_PORT=3306
DB_DATABASE=ideab2b
DB_USERNAME=ideab2b
# DB_PASSWORD is set via Secret Manager

# Cache & Session
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Redis (Cloud Memorystore)
REDIS_HOST=10.0.0.4  # Cloud Memorystore private IP
REDIS_PORT=6379
REDIS_PASSWORD=null

# JWT/Sanctum
SANCTUM_STATEFUL_DOMAINS=ideab2b-173142818446.asia-south2.run.app,*.ideab2b-173142818446.asia-south2.run.app
SESSION_DOMAIN=.ideab2b-173142818446.asia-south2.run.app

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Mail (if needed)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@ideaholiday.com
MAIL_FROM_NAME="${APP_NAME}"

# API Configuration
API_PAGINATION_LIMIT=50
API_RATE_LIMIT=60

# Frontend URL
FRONTEND_URL=https://ideab2b-173142818446.asia-south2.run.app

# Google Cloud Storage (if needed)
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=null
AWS_SECRET_ACCESS_KEY=null
AWS_DEFAULT_REGION=asia-south2
AWS_BUCKET=null
