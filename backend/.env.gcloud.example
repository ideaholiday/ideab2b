# Google Cloud Production Environment Variables for Laravel Backend

# Application Settings
APP_NAME="IdeaB2B Travel Platform"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ideab2b-173142818446.asia-south2.run.app

# Database Configuration (Cloud SQL)
DB_CONNECTION=mysql
DB_HOST=<CLOUD_SQL_INSTANCE_CONNECTION_NAME>
DB_PORT=3306
DB_DATABASE=ideab2b
DB_USERNAME=ideab2b
DB_PASSWORD=<FROM_SECRET_MANAGER>

# Cache Configuration
CACHE_DRIVER=redis
CACHE_PREFIX=ideab2b_

# Session Configuration
SESSION_DRIVER=redis
SESSION_DOMAIN=.ideab2b-173142818446.asia-south2.run.app
SESSION_SECURE_COOKIES=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queue Configuration
QUEUE_CONNECTION=redis

# Redis Configuration (Cloud Memorystore)
REDIS_HOST=<MEMORYSTORE_IP_ADDRESS>
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# Sanctum / JWT Configuration
SANCTUM_STATEFUL_DOMAINS=ideab2b-173142818446.asia-south2.run.app,*.ideab2b-173142818446.asia-south2.run.app
SANCTUM_GUARD=sanctum
SANCTUM_EXPIRATION=525600

# JWT Secret
JWT_SECRET=<FROM_SECRET_MANAGER>
JWT_ALGORITHM=HS256

# Logging Configuration
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ideaholiday.com
MAIL_FROM_NAME="${APP_NAME}"

# API Configuration
API_PAGINATION_LIMIT=50
API_RATE_LIMIT=60

# CORS Configuration
CORS_ALLOWED_ORIGINS="https://ideab2b-173142818446.asia-south2.run.app"

# Frontend URL
FRONTEND_URL=https://ideab2b-173142818446.asia-south2.run.app
FRONTEND_APP_URL=https://ideab2b-173142818446.asia-south2.run.app

# Broadcast Configuration (if needed)
BROADCAST_DRIVER=log
BROADCAST_HOST=127.0.0.1
BROADCAST_PORT=6379

# File Storage Configuration
FILESYSTEM_DISK=local
FILESYSTEM_VISIBILITY=private

# Google Cloud Storage (optional)
# FILESYSTEM_DISK=gcs
# FILESYSTEM_CLOUD_DRIVER=gcs
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=asia-south2
# AWS_BUCKET=ideab2b-storage

# Cloud Trace & Monitoring (Google Cloud specific)
GOOGLE_PROJECT_ID=173142818446
GOOGLE_APPLICATION_CREDENTIALS=/var/secrets/google/key.json

# Performance Monitoring
ENABLE_QUERY_LOG=false
SLOW_QUERY_THRESHOLD=1000

# Security Headers
SECURE_HSTS_MAX_AGE=31536000
SECURE_SSL_REDIRECT=true
SECURE_HSTS_INCLUDE_SUBDOMAINS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Trusted Proxies (for Cloud Load Balancer)
TRUSTED_PROXIES=*

# Timezone
APP_TIMEZONE=Asia/Kolkata

# Locale
APP_LOCALE=en
FALLBACK_LOCALE=en
