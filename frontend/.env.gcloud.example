# Google Cloud Production Environment Variables for React Frontend

# API Configuration
VITE_API_URL=https://ideab2b-173142818446.asia-south2.run.app/api
VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_NAME=IdeaB2B Travel Platform
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# Base URL
VITE_BASE_URL=https://ideab2b-173142818446.asia-south2.run.app/

# Authentication Configuration
VITE_AUTH_TOKEN_KEY=auth_token
VITE_AUTH_USER_KEY=auth_user
VITE_AUTH_REMEMBER_ME=true
VITE_TOKEN_EXPIRY=525600

# Security Configuration
VITE_SECURE_COOKIES=true
VITE_HTTP_ONLY=true
VITE_SAME_SITE=Lax

# Google Analytics
VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXXXX-X
VITE_ENABLE_ANALYTICS=true

# Sentry (Error Tracking)
VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_ENABLE=true

# Feature Flags
VITE_ENABLE_DEBUG=false
VITE_ENABLE_DEV_TOOLS=false
VITE_ENABLE_MOCK_API=false

# Pagination
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100

# Timeouts
VITE_REQUEST_TIMEOUT=30000
VITE_SESSION_TIMEOUT=900000

# Geolocation
VITE_DEFAULT_LOCATION=India
VITE_DEFAULT_CURRENCY=INR
VITE_DEFAULT_TIMEZONE=Asia/Kolkata

# Map Configuration (if using maps)
VITE_GOOGLE_MAPS_API_KEY=xxxxxxxxxxxx
VITE_MAP_DEFAULT_CENTER={"lat": 20.5937, "lng": 78.9629}
VITE_MAP_DEFAULT_ZOOM=4

# Social Media Links
VITE_FACEBOOK_URL=https://facebook.com/ideaholiday
VITE_TWITTER_URL=https://twitter.com/ideaholiday
VITE_INSTAGRAM_URL=https://instagram.com/ideaholiday

# Support Configuration
VITE_SUPPORT_EMAIL=support@ideaholiday.com
VITE_SUPPORT_PHONE=+91-XXXXXXXXXX

# Cache Configuration
VITE_CACHE_ENABLED=true
VITE_CACHE_MAX_AGE=3600

# PWA Configuration
VITE_PWA_ENABLED=true
VITE_PWA_SCOPE=/

# CDN Configuration (optional)
VITE_CDN_URL=https://cdn.ideaholiday.com/
VITE_USE_CDN=false

# Maintenance Mode
VITE_MAINTENANCE_MODE=false
VITE_MAINTENANCE_MESSAGE=The website is under maintenance. Please try again later.
